# SMTP (Mailgun) — wysyłka maili z formularza kontaktowego (/api/contact)
MAIL_HOST=smtp.eu.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=OnboardingToGo

# Adres, na który trafiają wiadomości z formularza
CONTACT_RECIPIENT=inbox@example.com
