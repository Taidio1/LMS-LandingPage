---
import type { Lang } from '../../i18n/index';
import { Compositor } from '../compositor/Compositor';

interface Props { lang?: Lang; }

const { lang = 'en' } = Astro.props;

const copy = {
  en: {
    label: 'Component Library',
    titleStart: 'Build your LMS,',
    titleHighlight: 'your way',
    subtitle: 'Browse available modules and UI components. Select what you need, preview your application live, and request a personalised demo.',
  },
  pl: {
    label: 'Biblioteka komponentow',
    titleStart: 'Zbuduj swoj LMS',
    titleHighlight: 'po swojemu',
    subtitle: 'Przegladaj dostepne moduly i komponenty UI. Wybierz to, czego potrzebujesz, podejrzyj aplikacje na zywo i zamow spersonalizowane demo.',
  },
  de: {
    label: 'Komponentenbibliothek',
    titleStart: 'Bauen Sie Ihr LMS',
    titleHighlight: 'auf Ihre Weise',
    subtitle: 'Durchsuchen Sie verfuegbare Module und UI-Komponenten. Waehlen Sie aus, was Sie brauchen, sehen Sie eine Live-Vorschau und fragen Sie eine personalisierte Demo an.',
  },
} satisfies Record<Lang, {
  label: string;
  titleStart: string;
  titleHighlight: string;
  subtitle: string;
}>;

const t = copy[lang];
---

<main>
  <section style="padding: 48px 0 24px;">
    <div class="container">
      <p class="section-label reveal">{t.label}</p>
      <h1 style="font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; color: var(--text-primary); margin: 8px 0 12px; line-height: 1.15;">
        {t.titleStart} <span class="gradient-text">{t.titleHighlight}</span>
      </h1>
      <p style="font-size: 1.0625rem; color: var(--text-secondary); line-height: 1.65; max-width: 560px;">
        {t.subtitle}
      </p>
    </div>
  </section>
  <div style="padding-bottom: 64px;">
    <Compositor client:load />
  </div>
</main>
