---
import type { Lang } from '../../i18n/index';
import { en } from '../../i18n/en';
import { pl } from '../../i18n/pl';
import { de } from '../../i18n/de';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = (lang === 'de' ? de : lang === 'pl' ? pl : en).socialProof;

const colors = ['blue', 'green', 'amber', 'violet'];
---

<div class="social-proof">
  <div class="container social-proof__inner">
    <div class="social-proof__audience">
      <span class="social-proof__label">{t.audienceLabel}</span>
      <div class="social-proof__chips" aria-label={t.audienceLabel}>
        {t.audiences.map((audience, index) => (
          <span class={`audience-chip audience-chip--${colors[index % colors.length]}`}>
            {audience}
          </span>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .social-proof {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: 26px 0;
  }

  .social-proof__inner {
    display: flex;
    align-items: center;
  }

  .social-proof__audience {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    width: 100%;
  }

  .social-proof__label {
    color: var(--text-secondary);
    flex: 0 0 auto;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }

  .social-proof__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-start;
    min-width: 0;
    width: 100%;
  }

  .audience-chip {
    align-items: center;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--text-primary);
    display: inline-flex;
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    min-height: 34px;
    padding: 0 12px;
    white-space: nowrap;
  }

  .audience-chip--blue {
    background: #eef6ff;
    border-color: #dbeafe;
  }

  .audience-chip--green {
    background: #ecfdf5;
    border-color: #bbf7d0;
  }

  .audience-chip--amber {
    background: #fffbeb;
    border-color: #fde68a;
  }

  .audience-chip--violet {
    background: #f5f3ff;
    border-color: #ddd6fe;
  }

  @media (max-width: 980px) {
    .social-proof__chips {
      justify-content: flex-start;
    }
  }

  @media (max-width: 680px) {
    .social-proof {
      padding: 22px 0;
    }

    .social-proof__audience {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .audience-chip {
      white-space: normal;
    }
  }
</style>
