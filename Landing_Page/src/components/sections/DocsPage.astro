            id: 'admin-reports',
            title: 'Raporty',
            readTime: '5 min czytania',
            updated: 'maj 2026',
            body: [
              { type: 'p', text: 'Raporty są dostępne w Panel admina → Raporty. Filtruj według użytkownika, grupy, kursu lub zakresu dat.' },
