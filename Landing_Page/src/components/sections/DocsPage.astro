    label: 'Documentation',
    titleStart: 'OnBoardToGo',
    titleHighlight: 'Docs',
    subtitle: 'Guides, tutorials, and reference docs for platform admins and learners.',
    sections: [
      {
        id: 'getting-started',
        heading: 'Getting Started',
        articles: [
          {
