            ],
          },
        ],
      },
      {
        id: 'learners',
        heading: 'Dla kursantów',
        articles: [
          {
            id: 'taking-courses',
            title: 'Jak się uczyć',
            readTime: '3 min czytania',
            updated: 'maj 2026',
            body: [
              { type: 'p', text: 'Po zalogowaniu przypisane kursy widoczne są na pulpicie. Kliknij kurs, aby go rozpocząć lub kontynuować od miejsca, w którym skończyłeś.' },
              { type: 'tip', text: 'Postęp jest zapisywany automatycznie — możesz zamknąć przeglądarkę i wrócić dokładnie w tym samym miejscu.' },
            ],
          },
          {
            id: 'certificates',
            title: 'Certyfikaty',
            readTime: '2 min czytania',
            updated: 'maj 2026',
            body: [
              { type: 'p', text: 'Po ukończeniu kursu certyfikat jest automatycznie generowany i wysyłany e-mailem. Możesz go też pobrać w dowolnym momencie z profilu.' },
            ],
          },
          {
            id: 'tracking-progress',
            title: 'Śledzenie postępów',
            readTime: '3 min czytania',
            updated: 'maj 2026',
            body: [
              { type: 'p', text: 'Strona profilu pokazuje procent ukończenia wszystkich przypisanych kursów, wyniki quizów i czas spędzony na nauce.' },
            ],
          },
        ],
