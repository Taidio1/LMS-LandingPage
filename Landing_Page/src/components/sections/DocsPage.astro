          {
            id: 'first-login',
            title: 'Pierwsze logowanie',
            readTime: '3 min czytania',
            updated: 'maj 2026',
            body: [
              { type: 'p', text: 'Po skonfigurowaniu platformy otrzymasz link do logowania i dane dostępowe na podany adres e-mail.' },
              { type: 'h3', text: 'Pierwsze logowanie' },
