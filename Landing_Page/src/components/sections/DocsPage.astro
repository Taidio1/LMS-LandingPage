      {
        id: 'whitelabel',
        heading: 'White-label i branding',
        articles: [
          {
            id: 'custom-domain',
            title: 'Własna domena',
            readTime: '5 min czytania',
            updated: 'maj 2026',
            body: [
              { type: 'p', text: 'W planie Platform + Brand możesz udostępnić LMS pod własną domeną (np. nauka.twojafirma.pl).' },
              { type: 'h3', text: 'Konfiguracja DNS' },
              { type: 'p', text: 'Utwórz rekord CNAME wskazujący na Twoją subdomenę OnBoardToGo. Certyfikat SSL konfigurujemy automatycznie.' },
              { type: 'tip', text: 'Propagacja DNS może zająć do 48 godzin, zazwyczaj jednak trwa mniej niż godzinę.' },
            ],
          },
          {
            id: 'logo-colors',
            title: 'Logo i kolory',
            readTime: '3 min czytania',
            updated: 'maj 2026',
            body: [
              { type: 'p', text: 'Prześlij logo i ustaw kolory marki w Panel admina → Branding. Zmiany są widoczne natychmiast na całej platformie.' },
            ],
          },
          {
            id: 'branded-emails',
            title: 'Wiadomości pod własną marką',
            readTime: '4 min czytania',
            updated: 'maj 2026',
            body: [
              { type: 'p', text: 'Wysyłaj zaproszenia, potwierdzenia ukończenia i przypomnienia z własnej domeny. Wymaga konfiguracji DNS (rekordy SPF + DKIM).' },
              { type: 'tip', text: 'Dostarczamy dokładne wartości rekordów DNS do dodania — bez potrzeby wiedzy technicznej.' },
            ],
          },
        ],
      },
      {
        id: 'integrations',
        heading: 'Integracje',
        articles: [
          {
            id: 'sso-setup',
            title: 'Konfiguracja SSO',
            readTime: '8 min czytania',
            updated: 'maj 2026',
            body: [
              { type: 'p', text: 'OnBoardToGo obsługuje SAML 2.0 i OAuth 2.0 (Single Sign-On). Dostępne w planie Platform + Brand.' },
              { type: 'h3', text: 'Podłączenie dostawcy tożsamości' },
              { type: 'p', text: 'Przejdź do Panel admina → Integracje → SSO. Wklej URL metadanych dostawcy tożsamości lub prześlij plik XML. Przetestuj połączenie przed włączeniem.' },
              { type: 'tip', text: 'Działa z Okta, Azure AD, Google Workspace i większością dostawców zgodnych z SAML.' },
            ],
          },
          {
            id: 'hr-tools',
            title: 'Narzędzia HR',
            readTime: '5 min czytania',
            updated: 'maj 2026',
            body: [
              { type: 'p', text: 'Synchronizuj pracowników automatycznie z BambooHR lub Workday. Nowi pracownicy są automatycznie zakładani i przypisywani do kursów onboardingowych.' },
            ],
          },
          {
            id: 'zapier-make',
            title: 'Zapier i Make',
            readTime: '4 min czytania',
            updated: 'maj 2026',
            body: [
              { type: 'p', text: 'Użyj aplikacji OnBoardToGo w Zapierze lub modułu Make, aby automatyzować procesy: przypisuj kursy po wiadomości na Slacku, powiadamiaj managerów o ukończeniu, eksportuj dane do Google Sheets i wiele więcej.' },
            ],
          },
        ],
      },
    ],
  },
};

const t = lang === 'pl' ? content.pl : content.en;
const allArticles = t.sections.flatMap(s =>
  s.articles.map(a => ({ ...a, sectionHeading: s.heading, sectionId: s.id }))
);
---

<main class="docs-layout">
  <div class="docs-header">
    <div class="container">
      <p class="section-label reveal">{t.label}</p>
      <h1 class="docs-title">
        {t.titleStart} <span class="gradient-text">{t.titleHighlight}</span>
      </h1>
      <p class="docs-subtitle">{t.subtitle}</p>
    </div>
  </div>

  <div class="container docs-body">
    <aside class="docs-sidebar" id="docsSidebar">
      {t.sections.map(section => (
        <div class="docs-sidebar__group">
          <div class="docs-sidebar__category">{section.heading}</div>
          {section.articles.map(article => (
            <a
              href={`#${article.id}`}
              class="docs-sidebar__link"
              data-article={article.id}
            >
              {article.title}
            </a>
          ))}
        </div>
      ))}
    </aside>

    <div class="docs-content">
      {allArticles.map((article, i) => (
        <section id={article.id} class="docs-section">
          <div class="docs-breadcrumb">
            {t.label} &rsaquo; {article.sectionHeading} &rsaquo; {article.title}
          </div>
          <h2 class="docs-article-title">{article.title}</h2>
          <div class="docs-meta">
            <span>&#x23F1; {article.readTime}</span>
            <span>&#x1F504; {article.updated}</span>
          </div>
          {article.body.map(block =>
            block.type === 'p' ? (
              <p class="docs-p">{block.text}</p>
            ) : block.type === 'h3' ? (
              <h3 class="docs-h3">{block.text}</h3>
            ) : (
              <div class="docs-tip">{block.text}</div>
            )
          )}
          <div class="docs-nav">
            {i > 0 && (
              <a href={`#${allArticles[i - 1].id}`} class="docs-nav__prev">
                &larr; {allArticles[i - 1].title}
              </a>
            )}
            {i < allArticles.length - 1 && (
              <a href={`#${allArticles[i + 1].id}`} class="docs-nav__next">
                {allArticles[i + 1].title} &rarr;
              </a>
            )}
          </div>
        </section>
      ))}
    </div>
  </div>
</main>

<style>
.docs-layout { min-height: 100vh; }

.docs-header {
  padding: 48px 0 32px;
  border-bottom: 1px solid var(--border-subtle);
  background: var(--bg-surface);
}
.docs-title {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 800;
  color: var(--text-primary);
  margin: 8px 0 12px;
  line-height: 1.15;
}
.docs-subtitle {
  font-size: 1.0625rem;
  color: var(--text-secondary);
  line-height: 1.65;
  max-width: 560px;
}

.docs-body {
  display: flex;
  gap: 0;
  min-height: calc(100vh - 200px);
  align-items: flex-start;
}

.docs-sidebar {
  width: 220px;
  flex-shrink: 0;
  padding: 32px 0;
  border-right: 1px solid var(--border-subtle);
  position: sticky;
  top: 68px;
  max-height: calc(100vh - 68px);
  overflow-y: auto;
}
.docs-sidebar__group { margin-bottom: 4px; }
.docs-sidebar__group + .docs-sidebar__group .docs-sidebar__category {
  border-top: 1px solid var(--border-subtle);
}
.docs-sidebar__category {
  font-size: 11px;
  font-weight: 700;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 16px 16px 8px;
}
.docs-sidebar__link {
  display: block;
  padding: 6px 16px;
  font-size: 13.5px;
  font-weight: 500;
  color: var(--text-secondary);
  border-left: 3px solid transparent;
  text-decoration: none;
  transition: var(--transition);
  line-height: 1.4;
}
.docs-sidebar__link:hover {
  color: var(--text-primary);
  background: rgba(37, 99, 235, 0.04);
}
.docs-sidebar__link.active {
  color: #2563eb;
  background: rgba(37, 99, 235, 0.07);
  border-left-color: #2563eb;
  font-weight: 600;
}

.docs-content {
  flex: 1;
  padding: 32px 48px 80px;
  min-width: 0;
}
.docs-section {
  padding-bottom: 64px;
  border-bottom: 1px solid var(--border-subtle);
  margin-bottom: 64px;
}
.docs-section:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.docs-breadcrumb {
  font-size: 12px;
  color: var(--text-secondary);
  opacity: 0.7;
  margin-bottom: 16px;
}
.docs-article-title {
  font-size: 1.625rem;
  font-weight: 800;
  color: var(--text-primary);
  margin: 0 0 10px;
  line-height: 1.2;
}
.docs-meta {
  display: flex;
  gap: 16px;
  font-size: 12px;
  color: var(--text-secondary);
  margin-bottom: 24px;
}
.docs-h3 {
  font-size: 1.0625rem;
  font-weight: 700;
  color: var(--text-primary);
  margin: 24px 0 8px;
}
.docs-p {
  font-size: 0.9375rem;
  color: var(--text-secondary);
  line-height: 1.75;
  margin: 0 0 16px;
}
.docs-tip {
  background: rgba(37, 99, 235, 0.06);
  border-left: 3px solid #2563eb;
  border-radius: 0 8px 8px 0;
  padding: 12px 16px;
  font-size: 0.875rem;
  color: #1e40af;
  margin: 16px 0;
  line-height: 1.6;
}

.docs-nav {
  display: flex;
  justify-content: space-between;
  margin-top: 32px;
  padding-top: 24px;
  border-top: 1px solid var(--border-subtle);
  gap: 16px;
}
.docs-nav__prev,
.docs-nav__next {
  font-size: 13.5px;
  font-weight: 600;
  color: #2563eb;
  text-decoration: none;
  transition: var(--transition);
  padding: 8px 16px;
  border: 1.5px solid rgba(37, 99, 235, 0.3);
  border-radius: 8px;
}
.docs-nav__prev:hover,
.docs-nav__next:hover {
  background: rgba(37, 99, 235, 0.06);
  border-color: #2563eb;
}
.docs-nav__next { margin-left: auto; }

@media (max-width: 768px) {
  .docs-body { flex-direction: column; }
  .docs-sidebar {
    width: 100%;
    position: static;
    max-height: none;
    border-right: none;
    border-bottom: 1px solid var(--border-subtle);
    padding: 16px 0;
  }
  .docs-content { padding: 24px 16px 48px; }
}
</style>

<script>
  const sidebarLinks = document.querySelectorAll<HTMLAnchorElement>('.docs-sidebar__link');
  const sections = document.querySelectorAll<HTMLElement>('.docs-section');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          sidebarLinks.forEach(link => {
            link.classList.toggle('active', link.getAttribute('data-article') === id);
          });
        }
      });
    },
    { rootMargin: '-10% 0px -70% 0px', threshold: 0 }
  );

  sections.forEach(section => observer.observe(section));

  if (sidebarLinks.length > 0) sidebarLinks[0].classList.add('active');
</script>
