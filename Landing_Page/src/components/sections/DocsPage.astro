---
import type { Lang } from '../../i18n/index';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;

type Block = { type: 'p' | 'h3' | 'tip'; text: string };
type Article = { id: string; title: string; readTime: string; updated: string; body: Block[] };
type Section = { id: string; heading: string; articles: Article[] };
type Content = {
  label: string; titleStart: string; titleHighlight: string; subtitle: string;
  sections: Section[];
};

const content: Record<'en' | 'pl', Content> = {
