            id: 'admin-courses',
            title: 'Kursy',
            readTime: '7 min czytania',
            updated: 'maj 2026',
            body: [
              { type: 'p', text: 'Twórz kursy za pomocą wbudowanego kreatora lub importuj istniejące pakiety SCORM 1.2/2004.' },
              { type: 'h3', text: 'Publikowanie i przypisywanie' },
              { type: 'p', text: 'Kurs musi być opublikowany przed przypisaniem. Przypisuj do użytkowników, grup lub wszystkich jednocześnie. Możesz ustawić termin i automatyczne przypomnienia.' },
            ],
          },
