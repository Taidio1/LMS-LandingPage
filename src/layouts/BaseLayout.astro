---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'OnboardToGo — Nowoczesna platforma edukacyjna',
  description = 'OnboardToGo to platforma LMS do zarządzania kursami i szkoleniami dla firm i pracowników. Onboarduj szybciej, ucz efektywniej.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/Logo_mini.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/animations.ts';
    </script>
  </body>
</html>
